# Copy to .env and adjust. Every value has a working default, so the service
# starts with no .env at all — that keeps `git clone && npm start` honest.

PORT=3000
NODE_ENV=development

# Omit DATABASE_URL and the service runs on PGlite (embedded WASM Postgres) with
# an on-disk directory. Set it and the same code talks to a real Postgres server.
# DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog

PGLITE_DATA_DIR=.data/catalog

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Seconds a GET stays fresh in a shared cache. This is the main lever for a
# read-heavy catalog; nginx in front honours it.
CACHE_MAX_AGE=60

RATE_LIMIT=600

# Set to require `X-API-Key` on writes. Unset means writes are open, which is
# fine locally and not fine in production.
# API_KEY=
